FILAZERO_API_URL=https://api.staging.filazero.net
FILAZERO_APP_ORIGIN=https://app.filazero.net
MCP_SERVER_PORT=3000
MCP_TRANSPORT=http
RATE_LIMIT_RPM=30
CACHE_TTL_COMPANIES=300
LOG_LEVEL=info
# Permite login via tool em modo HTTP (senha trafega entre cliente e servidor).
# Deixe false em produção — mantenha login só em stdio (Claude Desktop local).
ALLOW_HTTP_LOGIN=false
# Modo demo: quando true, as tools de availability/booking que dependem de
# agendas configuradas no Filazero (que a staging publica nao tem) servem
# dados mockados coerentes pra que o fluxo end-to-end funcione na demo.
# list_companies e get_company_services continuam reais.
FILAZERO_DEMO_MODE=true
